{
  "name": "chatluna-diary",
  "version": "0.1.2",
  "description": "Per-preset diary, conversation digest, stacked brush marks, media and scheduled writing for ChatLuna v2 WebUI.",
  "type": "module",
  "license": "MIT",
  "author": "chatluna-diary contributors",
  "homepage": "https://github.com/yabo083/chatluna-diary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabo083/chatluna-diary.git"
  },
  "bugs": {
    "url": "https://github.com/yabo083/chatluna-diary/issues"
  },
  "keywords": [
    "chatluna",
    "koishi",
    "diary",
    "journal",
    "llm",
    "plugin",
    "chatluna-v2"
  ],
  "main": "./server.js",
  "exports": {
    ".": "./server.js",
    "./client": "./client/index.tsx"
  },
  "files": [
    "index.ts",
    "diary-index.ts",
    "context-digest.ts",
    "entry-format.ts",
    "preset-scope.ts",
    "server.js",
    "client",
    "dist",
    "skills",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts",
    "test": "node --test context-digest.test.ts preset-scope.test.ts entry-format.test.ts diary-index.test.ts diary-sandbox.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
